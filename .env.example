# SSH-MCP Secure - Environment Configuration Example
# ⚠️ SECURITY WARNING: Never commit actual .env files to version control!
# Copy this file to .env and fill in your actual values securely

# =============================================================================
# SERVER CONFIGURATIONS
# =============================================================================
# Naming convention: SERVERNAME_PROPERTY
# Each server can use either password OR key-based authentication (not both)

# Example Server 1 - Production Server
MY_SERVER_HOST=example.com
MY_SERVER_PORT=22
MY_SERVER_USERNAME=myuser
# Choose ONE authentication method:
MY_SERVER_PASSWORD=              # Option 1: Password (not recommended for production)
MY_SERVER_PRIVATE_KEY_PATH=      # Option 2: Path to private key file (recommended)
MY_SERVER_PASSPHRASE=            # Optional: Passphrase if key is encrypted
MY_SERVER_DEFAULT_DIR=/home/myuser
MY_SERVER_DESCRIPTION=My Production Server

# Example Server 2 - Development Server
DEV_SERVER_HOST=dev.example.com
DEV_SERVER_PORT=22
DEV_SERVER_USERNAME=devuser
DEV_SERVER_PRIVATE_KEY_PATH=/path/to/dev_key
DEV_SERVER_DEFAULT_DIR=/home/devuser
DEV_SERVER_DESCRIPTION=Development Server

# =============================================================================
# SECURITY SETTINGS - CRITICAL
# =============================================================================

# ⚠️  CRITICAL: Master Secret for Key Derivation
# This is used with PBKDF2 to derive the actual encryption key
# MUST be at least 32 characters, use a strong random string
# NEVER commit this to version control!
ENCRYPTION_MASTER_SECRET=              # REQUIRED: Min 32 characters

# Optional: Custom key storage directory (defaults to %LOCALAPPDATA%/ssh-mcp-keys)
# KEY_STORAGE_DIRECTORY=C:/ssh-mcp-keys

# Authentication Security
SSH_ALLOW_PASSWORD_AUTH=false          # Disable password auth in production
SSH_MAX_AUTH_RETRIES=3                 # Max authentication attempts
SSH_LOCKOUT_DURATION=300               # Lockout duration in seconds (5 min)
SSH_REQUIRE_KEY_AUTH=true              # Require SSH key authentication

# SSH Key Security
SSH_KEY_TYPE=ed25519                   # Recommended: ed25519 or rsa-4096
SSH_KEY_MIN_BITS=4096                  # Minimum RSA key bits
SSH_KEY_PASSPHRASE_REQUIRED=true       # Require passphrase on private keys

# Connection Security
SSH_MAX_RETRIES=3                      # Max connection retries
SSH_RETRY_DELAY=2000                   # Delay between retries (ms)
SSH_CONNECTION_TIMEOUT=20000           # Connection timeout (ms)
SSH_KEEPALIVE_INTERVAL=10000           # Keepalive interval (ms)
SSH_STRICT_HOST_KEY_CHECKING=true      # Verify host keys

# Session Security
SSH_SESSION_TIMEOUT=3600               # Session timeout in seconds (1 hour)
SSH_MAX_SESSIONS_PER_USER=10           # Max concurrent sessions per user
SSH_SESSION_ENCRYPTION=AES-256-GCM     # Session encryption algorithm

# =============================================================================
# MULTI-FACTOR AUTHENTICATION (MFA)
# =============================================================================

MFA_ENABLED=true                       # Enable MFA
MFA_REQUIRED_FOR_PRODUCTION=true       # Require MFA for production servers
MFA_TOTP_ISSUER=SSH-MCP-Secure         # TOTP issuer name
MFA_TOTP_DIGITS=6                      # TOTP digits (6 or 8)
MFA_TOTP_PERIOD=30                     # TOTP period in seconds
MFA_BACKUP_CODES_COUNT=10              # Number of backup codes
MFA_WINDOW=1                           # TOTP verification window

# =============================================================================
# ENCRYPTION SETTINGS
# =============================================================================

# Credential Encryption at Rest
ENCRYPTION_ALGORITHM=AES-256-GCM       # Encryption algorithm
ENCRYPTION_KEY_LENGTH=256              # Key length in bits
ENCRYPTION_IV_LENGTH=12                # IV length in bytes
ENCRYPTION_TAG_LENGTH=16               # Authentication tag length
ENCRYPTION_KEY_ROTATION_DAYS=90        # Rotate encryption keys every 90 days

# TLS Settings
TLS_ENABLED=true                       # Enable TLS for external comms
TLS_MIN_VERSION=1.3                    # Minimum TLS version
TLS_CERTIFICATE_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem
TLS_CA_PATH=/path/to/ca.pem

# =============================================================================
# ACCESS CONTROL & RBAC
# =============================================================================

# Role-Based Access Control
RBAC_ENABLED=true
RBAC_DEFAULT_ROLE=viewer               # Default role for new users
RBAC_ADMIN_USERS=                      # Comma-separated list of admin users

# Permission Settings
PERMISSION_DENY_BY_DEFAULT=true        # Deny access unless explicitly allowed
PERMISSION_AUDIT_ALL=true              # Audit all permission checks

# =============================================================================
# AUDIT LOGGING & COMPLIANCE
# =============================================================================

# Audit Logging
AUDIT_ENABLED=true
AUDIT_LOG_PATH=/var/log/ssh-mcp/audit.log
AUDIT_LOG_MAX_SIZE=104857600           # 100MB
AUDIT_LOG_MAX_FILES=10                 # Keep 10 rotated files
AUDIT_RETENTION_DAYS=90                # Retain audit logs for 90 days
AUDIT_LOG_FORMAT=json                  # JSON format for structured logging
AUDIT_LOG_ASYNC=true                   # Async logging for performance

# What to Audit
AUDIT_AUTH_EVENTS=true                 # Authentication success/failure
AUDIT_COMMAND_EXECUTION=true           # All command executions
AUDIT_FILE_OPERATIONS=true             # File transfers and edits
AUDIT_SESSION_EVENTS=true              # Session create/close
AUDIT_PERMISSION_CHANGES=true          # Permission modifications
AUDIT_CREDENTIAL_ACCESS=true           # Credential access events
AUDIT_MFA_EVENTS=true                  # MFA verification events

# Compliance Frameworks
COMPLIANCE_FRAMEWORKS=soc2,gdpr,nist   # SOC2, GDPR, NIST CSF
COMPLIANCE_REPORTING_ENABLED=true
COMPLIANCE_REPORT_PATH=/var/log/ssh-mcp/compliance
COMPLIANCE_AUTO_REMEDIATION=false      # Auto-fix violations (careful!)

# =============================================================================
# PERFORMANCE & CONNECTION POOLING
# =============================================================================

# Connection Pool Settings
SSH_MIN_POOL_SIZE=5                    # Minimum pooled connections
SSH_MAX_POOL_SIZE=100                  # Maximum pooled connections
SSH_POOL_IDLE_TIMEOUT=300000           # Idle connection timeout (5 min)
SSH_POOL_ACQUIRE_TIMEOUT=10000         # Pool acquire timeout (10 sec)
SSH_POOL_ENABLE_HEALTH_CHECKS=true     # Enable connection health checks
SSH_POOL_ENABLE_ADAPTIVE_SCALING=true  # Auto-scale based on load

# Command Execution
SSH_COMMAND_TIMEOUT=60000              # Command timeout (60 sec)
SSH_MAX_COMMAND_OUTPUT=1048576         # Max output size (1MB)
SSH_COMMAND_RATE_LIMIT=100             # Max commands per minute per session

# =============================================================================
# REDIS CACHE SETTINGS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # Strong password required in production
REDIS_DB=0
REDIS_KEY_PREFIX=ssh-mcp-secure:
REDIS_TTL_SECONDS=300                  # Default cache TTL (5 min)
REDIS_ENABLE_TLS=false                 # Enable Redis TLS
REDIS_MAX_CONNECTIONS=10               # Max Redis connections

# Cache Strategy
CACHE_ENABLED=true
CACHE_STRATEGY=lru                     # LRU, LFU, or FIFO
CACHE_MAX_ENTRIES=10000                # Maximum cache entries
CACHE_MAX_MEMORY=256mb                 # Maximum cache memory

# =============================================================================
# MONITORING & ALERTING
# =============================================================================

# Prometheus Metrics
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=true
METRICS_COLLECTION_INTERVAL=10000      # Metrics interval (10 sec)
METRICS_LABELS=environment,server,role

# Grafana Dashboard
GRAFANA_PORT=3000
GRAFANA_ENABLED=true
GRAFANA_DASHBOARD_REFRESH=30s

# Alert Settings
ALERTING_ENABLED=true
ALERT_EMAIL=                           # Alert email address
ALERT_WEBHOOK_URL=                     # Slack/Teams webhook URL
ALERT_THRESHOLD_CRITICAL=5             # Critical alert threshold
ALERT_THRESHOLD_WARNING=10             # Warning alert threshold

# Error Monitoring
ERROR_MONITORING_ENABLED=true
ERROR_SAMPLE_RATE=1.0                  # Sample rate (1.0 = 100%)
ERROR_MAX_PER_SESSION=100              # Max errors tracked per session

# =============================================================================
# RESILIENCE & CIRCUIT BREAKERS
# =============================================================================

# Circuit Breaker Settings
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5            # Failures before opening
CIRCUIT_BREAKER_TIMEOUT=60000          # Time in half-open state (60 sec)
CIRCUIT_BREAKER_RESET_TIMEOUT=300000   # Time before reset (5 min)
CIRCUIT_BREAKER_MONITOR_WINDOW=60000   # Monitoring window (60 sec)

# Services to Protect
CIRCUIT_BREAKER_SERVICES=ssh,redis,auth,mfa,encryption

# Retry Settings
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
RETRY_BACKOFF_MULTIPLIER=2
RETRY_JITTER_MS=500

# =============================================================================
# MEMORY & LEARNING SYSTEM
# =============================================================================

SSH_MEMORY_PERSISTENCE=true
SSH_MEMORY_DATA_DIR=./data/memory
SSH_MEMORY_MAX_ENTRIES=10000
SSH_MEMORY_CONSOLIDATION_INTERVAL=3600000  # 1 hour
SSH_MEMORY_DECAY_RATE=0.1
SSH_MEMORY_CONFIDENCE_THRESHOLD=0.7
SSH_MEMORY_ENABLE_ML=false             # Enable ML-based learning

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

BACKUP_ENABLED=true
BACKUP_PATH=/var/backups/ssh-mcp
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true                 # Encrypt backups
BACKUP_SCHEDULE=0 2 * * *              # Daily at 2 AM (cron format)
BACKUP_VERIFY_INTEGRITY=true           # Verify backup integrity

# =============================================================================
# AI INTELLIGENCE SETTINGS
# =============================================================================

# Context7 Integration (Documentation)
CONTEXT7_API_KEY=                      # Get from context7.com
CONTEXT7_ENABLED=true
CONTEXT7_CACHE_DOCS=true

# GitHub Intelligence
GITHUB_TOKEN=                          # GitHub personal access token
GITHUB_INTELLIGENCE_ENABLED=true
GITHUB_PATTERN_MINING=true
GITHUB_BEST_PRACTICES=true

# ML-Based Features
ML_COMMAND_PREDICTION=false            # Predict next commands
ML_ANOMALY_DETECTION=false             # Detect anomalous behavior
ML_WORKFLOW_OPTIMIZATION=false         # Optimize workflows

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

LOG_LEVEL=info                         # debug, info, warn, error
LOG_FILE_PATH=/var/log/ssh-mcp/ssh-mcp.log
LOG_MAX_SIZE=10485760                  # 10MB
LOG_MAX_FILES=5
LOG_COMPRESSION=true
LOG_FORMAT=json                        # JSON or text
LOG_TIMESTAMP=true
LOG_COLORS=false                       # Disable colors in production

# =============================================================================
# API & SERVER SETTINGS
# =============================================================================

SERVER_PORT=3001
SERVER_HOST=0.0.0.0
SERVER_ENV=production                  # development, staging, production
SERVER_RATE_LIMIT=100                  # Requests per minute
SERVER_MAX_BODY_SIZE=1mb               # Max request body size
SERVER_CORS_ENABLED=false              # Disable CORS in production
SERVER_TRUST_PROXY=true                # Trust reverse proxy

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000            # 30 seconds

# =============================================================================
# KUBERNETES SETTINGS (if deploying to K8s)
# =============================================================================

KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=ssh-mcp
KUBERNETES_SERVICE_NAME=ssh-mcp-server
KUBERNETES_POD_NAME=                   # Auto-populated in K8s
KUBERNETES_NODE_NAME=                  # Auto-populated in K8s

# =============================================================================
# DEBUG & DEVELOPMENT (DISABLE IN PRODUCTION!)
# =============================================================================

DEBUG_MODE=false
DEBUG_LOG_PATH=/tmp/ssh-mcp-debug.log
DEBUG_VERBOSE_ERRORS=false
DEBUG_SKIP_AUTH=false                  # NEVER enable in production!
DEBUG_SKIP_MFA=false                   # NEVER enable in production!
DEBUG_SKIP_ENCRYPTION=false            # NEVER enable in production!

# =============================================================================
# SECURITY BEST PRACTICES CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] Set SSH_ALLOW_PASSWORD_AUTH=false
# [ ] Set SSH_REQUIRE_KEY_AUTH=true
# [ ] Generate ED25519 or RSA-4096 keys
# [ ] Set strong REDIS_PASSWORD
# [ ] Enable MFA (MFA_ENABLED=true)
# [ ] Set MFA_REQUIRED_FOR_PRODUCTION=true
# [ ] Configure audit logging paths
# [ ] Set LOG_LEVEL=info or warn
# [ ] Disable DEBUG_MODE
# [ ] Review and restrict RBAC permissions
# [ ] Enable encryption for backups
# [ ] Configure backup schedule
# [ ] Set up monitoring and alerting
# [ ] Test circuit breakers
# [ ] Review firewall rules
# [ ] Document emergency procedures
# =============================================================================
